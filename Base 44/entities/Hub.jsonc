{
  "name": "Hub",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do hub (ex: LRJ-02)"
    },
    "regional": {
      "type": "string",
      "enum": [
        "Regional 1",
        "Regional 2",
        "Regional 3",
        "Regional 4",
        "Regional ES 01"
      ],
      "description": "Regional do hub"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "LM",
        "FM"
      ],
      "description": "Tipo operacional: LM (Last Mile) ou FM (First Mile)"
    }
  },
  "required": [
    "name",
    "regional",
    "tipo"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}